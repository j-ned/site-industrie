---
import { client } from '../lib/client';

const { machines } = client;
const total = machines.items.reduce((n, m) => n + (m.count ?? 1), 0);
---

<section id="parc-machines" class="section border-y border-line bg-surface">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="h2">{machines.title}</h2>
        <p class="lead">{machines.intro}</p>
      </div>
      <p class="font-mono text-sm text-ink-soft">{total} machines au total</p>
    </div>

    <ul class="mt-12 grid gap-px overflow-hidden rounded-ui border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        machines.items.map((m) => (
          <li class="flex flex-col bg-bg p-6">
            <div class="flex items-start justify-between gap-4">
              <p class="text-sm font-medium text-ink-soft">{m.kind}</p>
              {m.count && (
                <span class="rounded-ui bg-surface-strong px-2 py-0.5 font-mono text-xs" aria-label={`${m.count} machines`}>
                  ×{m.count}
                </span>
              )}
            </div>
            <p class="mt-3 text-xl font-bold tracking-tight" style="font-stretch:108%">{m.model}</p>
            <p class="mt-auto pt-4 font-mono text-sm text-ink-soft">{m.capacity}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
