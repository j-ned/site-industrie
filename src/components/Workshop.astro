---
import { client, asset } from '../lib/client';

const [, second, third] = client.workshop;
const { company } = client;
const years = new Date().getFullYear() - company.foundedYear;
---

<section id="atelier" class="section">
  <div class="container-site grid gap-4 md:grid-cols-12">
    <div class="flex flex-col justify-center md:col-span-5 md:pr-10">
      <h2 class="h2">Un atelier à {company.address.city}, depuis {years} ans</h2>
      <p class="lead">
        Nos régleurs et programmeurs travaillent sur place, à quelques minutes de vos sites. Venez voir vos pièces en production : la porte de l’atelier est ouverte.
      </p>
    </div>
    <img src={asset(second.src)} alt={second.alt} loading="lazy" width="900" height="1100" class="aspect-[4/5] w-full rounded-ui object-cover md:col-span-4" />
    <img src={asset(third.src)} alt={third.alt} loading="lazy" width="900" height="1100" class="aspect-[4/5] w-full rounded-ui object-cover md:col-span-3 md:mt-16" />
  </div>
</section>
