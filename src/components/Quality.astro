---
import Icon from './Icon.astro';
import { client, asset } from '../lib/client';

const { quality } = client;
---

<section id="qualite" class="section border-t border-line">
  <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <img
      src={asset(quality.image.src)}
      alt={quality.image.alt}
      width="1200"
      height="1500"
      loading="lazy"
      class="aspect-[4/3] w-full rounded-ui object-cover lg:col-span-5 lg:aspect-[4/5]"
    />

    <div class="lg:col-span-7">
      <h2 class="h2">{quality.title}</h2>
      <p class="lead">{quality.text}</p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          quality.certifications.map((c) => (
            <div class="flex items-start gap-4 rounded-ui border border-line p-5">
              <Icon name="certificate" size={28} class="mt-0.5 shrink-0 text-accent" />
              <div>
                <p class="font-mono font-medium">{c.name}</p>
                <p class="mt-1 text-sm text-ink-soft">{c.detail}</p>
              </div>
            </div>
          ))
        }
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          quality.controls.map((c) => (
            <li class="flex items-start gap-3">
              <Icon name="check" size={20} class="mt-0.5 shrink-0 text-accent" />
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
