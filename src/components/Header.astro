---
import Icon from './Icon.astro';
import { client } from '../lib/client';

const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#savoir-faire`, label: 'Savoir-faire' },
  { href: `${base}#parc-machines`, label: 'Parc machines' },
  { href: `${base}#qualite`, label: 'Qualité' },
  { href: `${base}#atelier`, label: 'L’atelier' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur-md">
  <nav class="container-site flex h-16 items-center justify-between gap-6" aria-label="Navigation principale">
    <a href={base} class="flex items-center gap-2.5 font-bold tracking-tight" style="font-stretch:112%">
      <span class="grid size-8 place-items-center rounded-ui bg-ink text-sm text-bg" aria-hidden="true">
        {client.company.shortName.charAt(0)}
      </span>
      {client.company.shortName}
    </a>

    <ul class="hidden items-center gap-8 text-sm font-medium text-ink-soft lg:flex">
      {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-ink">{l.label}</a></li>)}
    </ul>

    <div class="flex items-center gap-3">
      <a href={`tel:${client.company.phone.replace(/\s/g, '')}`} class="hidden items-center gap-2 text-sm font-semibold md:flex">
        <Icon name="phone" size={18} class="text-accent" />
        {client.company.phone}
      </a>
      <a href={`${base}#devis`} class="btn-primary hidden py-2.5 text-sm sm:inline-flex">Demander un devis</a>

      <details class="group relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-ui border border-line [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu">
          <Icon name="list" size={20} class="group-open:hidden" />
          <Icon name="x" size={20} class="hidden group-open:block" />
        </summary>
        <div class="absolute right-0 top-12 w-64 rounded-ui border border-line bg-bg p-2 shadow-xl shadow-ink/10">
          {links.map((l) => <a href={l.href} class="block rounded-ui px-3 py-2.5 font-medium hover:bg-surface">{l.label}</a>)}
          <a href={`${base}#devis`} class="btn-primary mt-2 w-full">Demander un devis</a>
        </div>
      </details>
    </div>
  </nav>
</header>
