---
import Icon from './Icon.astro';
import { client } from '../lib/client';

const { company, credit } = client;
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-line bg-surface">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-bold" style="font-stretch:112%">{company.name}</p>
      <address class="mt-3 not-italic leading-relaxed text-ink-soft">
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}
      </address>
    </div>
    <div class="text-ink-soft">
      <p><a href={`tel:${company.phone.replace(/\s/g, '')}`} class="hover:text-ink">{company.phone}</a></p>
      <p class="mt-1"><a href={`mailto:${company.email}`} class="hover:text-ink">{company.email}</a></p>
      {
        company.linkedin && (
          <a href={company.linkedin} class="mt-4 inline-flex items-center gap-2 hover:text-ink" rel="noopener">
            <Icon name="linkedin-logo" size={20} />
            LinkedIn
          </a>
        )
      }
    </div>
    <div class="flex flex-col gap-1 text-sm text-ink-soft md:items-end">
      <a href={`${base}mentions-legales/`} class="hover:text-ink">Mentions légales et confidentialité</a>
      <p>© {new Date().getFullYear()} {company.name}</p>
      {credit && <a href={credit.url} class="hover:text-ink">{credit.label}</a>}
    </div>
  </div>
</footer>
