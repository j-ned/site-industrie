---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Figures from '../components/Figures.astro';
import Services from '../components/Services.astro';
import Machines from '../components/Machines.astro';
import MaterialsSectors from '../components/MaterialsSectors.astro';
import Quality from '../components/Quality.astro';
import Process from '../components/Process.astro';
import Workshop from '../components/Workshop.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="contenu">
    <Hero />
    <Figures />
    <Services />
    <Machines />
    <MaterialsSectors />
    <Quality />
    <Process />
    <Workshop />
    <Contact />
  </main>
  <Footer />
</Base>
